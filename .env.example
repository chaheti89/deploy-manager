DATABASE_URL=postgresql+asyncpg://deployguard:deployguard@db:5432/deployguard
ANTHROPIC_API_KEY=your_anthropic_key_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
VOYAGE_API_KEY=your_voyage_key_here
GITHUB_TOKEN=your_github_pat_here   # optional but recommended — raises API rate limit from 60 to 5000 req/hr
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK   # optional

# Email alerts (all optional — fill all four to enable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_TO=oncall@yourcompany.com
