# Copy to .env and fill in your values
# cp .env.example .env

# Required
DATABASE_URL=postgresql+asyncpg://deployguard:deployguard@localhost:5432/deployguard
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
VOYAGE_API_KEY=your_voyage_api_key_here

# Optional — raises GitHub API rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=

# Optional — Slack alerts on HIGH/CRITICAL deploys
SLACK_WEBHOOK_URL=

# Optional — email alerts on HIGH/CRITICAL deploys (all five required together)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_TO=recipient@example.com
